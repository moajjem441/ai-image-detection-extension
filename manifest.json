{
  
  "manifest_version": 3,
  "name": "AI Image Detector",
  "version": "1.0",
  "description": "Detect whether an image is Real or AI-Generated.",
  "permissions": ["contextMenus", "notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}